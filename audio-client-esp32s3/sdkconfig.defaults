CONFIG_ESP_MAIN_TASK_STACK_SIZE=12288
CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=12288
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
CONFIG_LWIP_TCPIP_TASK_STACK_SIZE=4096
CONFIG_FREERTOS_IDLE_TASK_STACKSIZE=4096
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"
# Board has 16MB flash
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_MODEL_IN_FLASH=y
CONFIG_USE_AFE=y
# VADNet: medium model
CONFIG_SR_VADN_VADNET1_MEDIUM=y
# WakeNet: "Hi Jason" (wn9s_hijason) - small model, có sẵn trong managed_components
CONFIG_SR_WN_WN9S_HIJASON=y
# PSRAM: board có 8MB PSRAM embedded (OPI), cần bật để AFE dùng ALLOC_MORE_PSRAM
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096